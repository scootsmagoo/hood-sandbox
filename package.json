{
  "name": "hood-sandbox",
  "private": true,
  "version": "0.0.1",
  "description": "A GTA-style open-world crime sandbox built from real cities, running in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:controls": "node scripts/controls-check.mjs",
    "check:controls:webkit": "node scripts/controls-check.mjs --browser webkit",
    "shot": "node scripts/shot.mjs",
    "shots:demo": "node scripts/demo-shots.mjs",
    "shots:chars": "node scripts/char-shots.mjs",
    "perf-budget": "node scripts/perf-budget.mjs --repeat 2",
    "perf-budget:phone": "node scripts/perf-budget.mjs --profile phone-low --repeat 2",
    "soak": "node scripts/soak.mjs",
    "leaks": "node scripts/leaks.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:dry": "npm run build && npm run deploy:check && wrangler deploy --dry-run",
    "deploy": "npm run build && npm run deploy:check && wrangler deploy",
    "audit:collision": "vitest run --config vitest.audit.config.ts",
    "assets": "node tools/blender/build.mjs && node tools/blender/characters/build.mjs && vitest run tests/carAssets.test.ts tests/anchorProps.test.ts tests/characterAssets.test.ts tests/landmarkAssets.test.ts tests/transitAssets.test.ts tests/airportAircraft.test.ts tests/airportHeroes.test.ts",
    "audit:ground": "node scripts/ground-audit.mjs",
    "bake:m2": "cd tools/pipeline && npm run bake:m2 --",
    "prefetch:m2": "cd tools/pipeline && npm run prefetch:m2 --",
    "prefetch:airport": "cd tools/pipeline && npm run prefetch:m2 -- --grid airport --merged",
    "bake:airport": "cd tools/pipeline && npm run bake:m2 -- --grid airport",
    "shots:airport": "node scripts/airport-shots.mjs",
    "shots:stream": "node scripts/stream-shots.mjs",
    "shots:map": "node scripts/map-shots.mjs",
    "perf:nav": "node scripts/nav-cost.mjs",
    "perf:stream": "node scripts/stream-perf.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
