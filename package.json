{
  "name": "hood-sandbox",
  "private": true,
  "version": "0.0.1",
  "description": "A GTA-style open-world crime sandbox built from real cities, running in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:controls": "node scripts/controls-check.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
